[Unit]
Description=VodShelf - Next.js Application
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/var/www/vodshelf

Environment=NODE_ENV=production
Environment=PORT=3005
Environment=HOSTNAME=0.0.0.0

EnvironmentFile=-/var/www/vodshelf/.env.local

# Automatically fix directory and database permissions on startup
ExecStartPre=+/bin/sh -c 'chown -R www-data:www-data /var/www/vodshelf && chmod -R 775 /var/www/vodshelf'

ExecStart=/usr/bin/node ./node_modules/.bin/next start --port 3005 --hostname 0.0.0.0

Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
LimitNOFILE=65535
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vodshelf

[Install]
WantedBy=multi-user.target
